# Copiez ce fichier en .env.local et renseignez vos identifiants Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Requis pour le tableau de bord admin (Project Settings → API → service_role).
# Ne jamais exposer côté client.
SUPABASE_SERVICE_ROLE_KEY=

# Liste d'e-mails autorisés à voir /admin, séparés par des virgules.
ADMIN_EMAILS=

# Optionnel — Phase 2, recherche en langage naturel
ANTHROPIC_API_KEY=
ANTHROPIC_SEARCH_MODEL=claude-opus-5
